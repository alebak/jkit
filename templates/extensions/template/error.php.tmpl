defined('_JEXEC') or die;

/** @var \Joomla\CMS\Document\ErrorDocument $this */

$app   = $this->getApplication();
$user  = $app->getIdentity();

// Get the error details
$error  = $app->getError();
$code   = $error ? $error->getCode() : 500;
$message = $error ? $error->getMessage() : \Joomla\CMS\Language\Text::_('JERROR_AN_ERROR_HAS_OCCURRED');

?><!DOCTYPE html>
<html lang="<?php echo $this->language; ?>" dir="<?php echo $this->direction; ?>">
<head>
    <title><?php echo $code; ?> - <?php echo htmlspecialchars($app->get('sitename')); ?></title>
    <jdoc:include type="head" />
</head>
<body class="error <?php echo $this->direction === 'rtl' ? 'rtl' : ''; ?>">
    <div class="container">
        <h1><?php echo $code; ?> - <?php echo \Joomla\CMS\Language\Text::_('JERROR_AN_ERROR_HAS_OCCURRED'); ?></h1>
        <p><?php echo htmlspecialchars($message, ENT_QUOTES, 'UTF-8'); ?></p>
        <p><a href="<?php echo $this->baseurl; ?>" class="btn btn-primary"><?php echo \Joomla\CMS\Language\Text::_('JERROR_LAYOUT_HOME_PAGE'); ?></a></p>
    </div>
</body>
</html>
